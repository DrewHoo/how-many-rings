{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "how-many-rings-og",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  // Route patterns only match a query string through a trailing wildcard, so the
  // Worker sees the whole subtree; anything other than ?open= on the page and
  // og/<id>.png is a plain pass-through to GitHub Pages.
  "routes": [
    { "pattern": "drewhoover.com/how-many-rings/*", "zone_name": "drewhoover.com" }
  ],
  "workers_dev": false,
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.css"], "fallthrough": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true }
  }
}
